{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": false,
  "redirects": [
    { "source": "/gate", "destination": "/", "permanent": false },
    { "source": "/room", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/home",     "destination": "/index.html" },
    { "source": "/rogerai",  "destination": "/index.html" },
    { "source": "/tdc",      "destination": "/tdc/index.html" },
    { "source": "/tdc/",     "destination": "/tdc/index.html" },
    { "source": "/tdc/:path*", "destination": "/tdc/:path*" },
    { "source": "/edgetack", "destination": "/index.html" },
    { "source": "/dart",      "destination": "/dart/index.html" },
    { "source": "/dart/",     "destination": "/dart/index.html" },
    { "source": "/dart/:path*", "destination": "/dart/:path*" },
    { "source": "/ummiwallet",          "destination": "/ummiwallet/index.html" },
    { "source": "/ummiwallet/",         "destination": "/ummiwallet/index.html" },
    { "source": "/ummiwallet/:path*",   "destination": "/ummiwallet/:path*" },
    { "source": "/cliniq.one",          "destination": "/cliniq.one/index.html" },
    { "source": "/cliniq.one/",         "destination": "/cliniq.one/index.html" },
    { "source": "/cliniq.one/:path*",   "destination": "/cliniq.one/:path*" },
    { "source": "/xhb",        "destination": "/xhb/index.html" },
    { "source": "/xhb/",       "destination": "/xhb/index.html" },
    { "source": "/xhb/:path*", "destination": "/xhb/:path*" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "no-referrer" }
      ]
    },
    {
      "source": "/(|home)(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}

