{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "cliniq.one" }],
      "destination": "https://momencrafts.com/cliniq",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.cliniq.one" }],
      "destination": "https://momencrafts.com/cliniq",
      "permanent": true
    },
    { "source": "/gate", "destination": "/", "permanent": false },
    { "source": "/room", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/home",     "destination": "/index.html" },
    { "source": "/rogerai",  "destination": "/index.html" },
    { "source": "/tdc",      "destination": "/tdc/index.html" },
    { "source": "/tdc/",     "destination": "/tdc/index.html" },
    { "source": "/tdc/:path*", "destination": "/tdc/:path*" },
    { "source": "/edgetack", "destination": "/index.html" },
    { "source": "/ummiwallet",          "destination": "/ummiwallet/index.html" },
    { "source": "/ummiwallet/",         "destination": "/ummiwallet/index.html" },
    { "source": "/ummiwallet/:path*",   "destination": "/ummiwallet/:path*" },
    { "source": "/admin",    "destination": "/admin/index.html" },
    { "source": "/admin/",   "destination": "/admin/index.html" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "no-referrer" }
      ]
    },
    {
      "source": "/(|home)(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
