{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "cliniq.one" }],
      "destination": "/cliniq.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.cliniq.one" }],
      "destination": "/cliniq.html"
    },
    { "source": "/gate",   "destination": "/gate.html" },
    { "source": "/room",   "destination": "/room.html" },
    { "source": "/cliniq", "destination": "/cliniq.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/room(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
