{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "cliniq.one" }],
      "destination": "/cliniq.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.cliniq.one" }],
      "destination": "/cliniq.html"
    },
    { "source": "/",      "destination": "/gate.html"   },
    { "source": "/home",  "destination": "/index.html"  },
    { "source": "/gate",  "destination": "/gate.html"   },
    { "source": "/cliniq", "destination": "/cliniq.html" }
  ],
  "redirects": [
    { "source": "/room", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/(gate|home|admin)(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
